<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP for Sophos captive portal gateway and Google connectivity check -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.56.2</domain>
        <domain includeSubdomains="true">10.4.0.1</domain>
        <domain includeSubdomains="true">connectivitycheck.gstatic.com</domain>
    </domain-config>
</network-security-config>
